###############################################################################
# nss-rk.qos (HW accelerated simple traffic shaper for Qualcomm NSS)
# version 20261120.2-dscp
#
# sqm-scripts queue script that shapes with the NSS offloaded nsstbl (token
# bucket) + nssfq_codel (fq_codel) qdiscs, so shaped traffic stays on the NSS
# cores. Select "fq_codel" as queue discipline and "nss-rk.qos" as script in
# LuCI (Network -> SQM QoS), on the eth device that carries the WAN traffic
# (eth0 on the R7800).
#
# Based on nss-rk.qos by rickk (https://github.com/rickkdotnet/sqm-scripts-nss),
# itself based on simple.qos and nss.qos by ricsc.
#
# Place it in /usr/lib/sqm/ (next to nss-rk.qos.help).
#
# What this version changes compared to the stock script
#
#   * Failures are no longer masked. The stock "cmd || (log && return 1)" idiom
#     runs "return" in a subshell, so egress()/ingress() always reported
#     success and sqm-scripts logged "started successfully" after every error.
#   * Start is all-or-nothing: if any step fails everything that was installed
#     is rolled back (sqm-scripts only runs stop when a state file exists, and
#     it only writes one after a successful start), then the start is retried
#     a few times to ride out transient NSS firmware timeouts at boot.
#   * Preflight: refuses to start with a clear message when the installed "tc"
#     has no NSS qdisc support. This is what happens when tc-full/tc-bpf from
#     the stock OpenWrt feed replaces the NSS-patched tc ("Unknown qdisc
#     nsstbl"). Also loads the qca-nss-qdisc / nss-ifb kernel modules.
#   * Readiness check before shaping (bounded, never hangs boot):
#       1. the eth device must exist and be administratively up (hard
#          requirement, nss_wait_timeout seconds);
#       2. the logical WAN interface (default: wan) should be up and have an
#          IPv4/IPv6 address (soft requirement, nss_wan_timeout seconds; on
#          timeout it logs a warning and shapes anyway, unless
#          nss_wan_required=1). Works for DHCP, PPPoE and IPv6-only WANs.
#   * The hotplug bail-out only skips the restart when an NSS shaper really is
#     installed (the old test succeeded whenever nssifb merely existed).
#   * No dependency on iptables helpers that sqm-scripts removed (nftables
#     based releases have no verify_iptables/ipt_log_*).
#   * State file and IFACE are left untouched, so stop-sqm finds the state
#     file it expects, also for VLAN style names such as eth0.2.
#   * Burst bytes are taken from the sqm section of THIS interface instead of
#     "@queue[0]". POSIX sh only, no "[[", "let" or recursion.
#   * Optional DSCP classes for the UPLOAD direction (nss_dscp_classes, off by
#     default, see below), optionally steered by static rules on ports,
#     addresses and protocols (nss_dscp_match). With them off this script builds
#     exactly the same shaper as before.
#
# Optional options in the sqm queue section (/etc/config/sqm), all optional:
#
#   option root_burst_up       '32768'   nsstbl burst in bytes, upload
#   option root_burst_down     '131072'  nsstbl burst in bytes, download
#                                        (unset: sqm default of 1000us worth)
#   option nss_wait_timeout    '30'      seconds to wait for the eth device
#   option nss_wan_iface       'wan'     logical interface to wait for,
#                                        'none' disables that check
#   option nss_wan_timeout     '20'      seconds to wait for it
#   option nss_wan_required    '0'       1: fail instead of shaping anyway
#   option nss_start_attempts  '3'       tries before giving up
#   option nss_keep_ifb        '1'       1: never delete nssifb on stop/restart,
#                                        0: delete and recreate it every time.
#                                        Default: 1 on kernels 5.10 and 6.18,
#                                        0 on every other kernel (see below)
#   option nss_reload_autorate '1'       1: after every successful start, ask a
#                                        RUNNING sqm-autorate to reload, so it
#                                        re-applies its rates and burst (SQM
#                                        has just reset them to the static
#                                        values). Does nothing when autorate
#                                        is not installed or not running and
#                                        never starts it. 0: do not touch it.
#
# DSCP classes (upload only; download is unchanged). Off by default.
#
#   option nss_dscp_classes    '0'       1: build three priority classes on the
#                                        upload shaper instead of one queue:
#                                          11: high   (nssprio band 1)
#                                          12: normal (band 2, the default)
#                                          13: bulk   (band 3)
#                                        and tag forwarded packets towards the
#                                        WAN by their DSCP so the NSS firmware
#                                        queues them in the matching class.
#   option nss_dscp_high       'cs4 cs5 cs6 cs7 ef va'
#                                        DSCP names or numbers (1-63) for the
#                                        high class (the cake diffserv3 voice
#                                        set). Names: cs1-cs7, af11-af43, ef,
#                                        va, le. 'none' for an empty class.
#   option nss_dscp_bulk       'cs1 le'  same, for the bulk class. A DSCP that is
#                                        in both lists stays in the high class.
#   option nss_dscp_wan_dev    ''        device the tag rules match as outgoing
#                                        interface. Default: the l3 device of
#                                        the logical interface nss_wan_iface
#                                        (wan on a DSA build, pppoe-wan on
#                                        PPPoE). Set it when that cannot be
#                                        determined.
#   option nss_dscp_sched      'nssprio' EXPERIMENTAL (nssprio is the proven one):
#                                        the NSS scheduler that shares the upload
#                                        between the three classes
#                                          nssprio  priority bands
#                                          nsswrr   weighted round robin (quantum
#                                                   in packets)
#                                          nsswfq   weighted fair queueing
#                                                   (quantum in bytes)
#                                        nsshtb is not offered: the 11.2 firmware
#                                        refuses its second class (nssq-probe.sh).
#                                        Run nssq-probe.sh first: it shows which of
#                                        them your firmware accepts. When the tree
#                                        cannot be built the script logs a warning
#                                        and builds nssprio, and when that fails
#                                        too the single queue.
#   option nss_dscp_weights    '4 2 1'   shares of high, normal and bulk: three
#                                        whole numbers 1-1000 (nsswrr and nsswfq;
#                                        nssprio ignores them)
#   option nss_dscp_match      ''        static rules by protocol, address and port.
#                                        They are checked BEFORE the DSCP lists and
#                                        the first rule that matches decides. A rule:
#                                          CLASS [PROTO] [saddr A] [daddr A] [sport P] [dport P]
#                                        CLASS: high, normal (stays in the normal
#                                        class whatever the DSCP says) or bulk.
#                                        PROTO: tcp, udp, icmp (IPv4 and IPv6), esp,
#                                        gre or sctp, or a comma list of them; with a
#                                        port and no PROTO it is tcp and udp.
#                                        A: comma list of addresses or prefixes of
#                                        ONE IP version (192.168.1.20, 10.0.0.0/8,
#                                        2001:db8::/32); saddr is the LAN side of the
#                                        flow. P: comma list of ports or ranges
#                                        (443, 50000-50100).
#                                        Several rules: a uci "list", or one option
#                                        with the rules separated by ";" or lines.
#                                          high udp dport 3478,19302-19309
#                                          bulk saddr 192.168.1.50
#                                          normal tcp dport 443 daddr 203.0.113.0/24
#                                        At most 32 rules, 16 values per list. A rule
#                                        that is not valid is ignored with a warning.
#                                        Needs nss_dscp_classes 1.
#
#   Everything else (DSCP 0 and all other values) goes to the normal class, as
#   does traffic nobody tagged. The classes are ordered by priority but the
#   NSS firmware does not starve the lower ones. The tag rules live in the nft
#   table "nss_dscp", which is created when SQM starts and removed when it
#   stops. Notes:
#     * the tag of a flow is read from its first packets; a flow keeps its
#       class for its whole life, also when the DSCP of later packets changes,
#       and connections that were already running when SQM (re)started stay in
#       the normal class until they are reopened. The same goes for the static
#       rules; they only see the first packets of a flow;
#     * only traffic that is forwarded (LAN to WAN) is tagged, not traffic of
#       the router itself;
#     * if the classes cannot be built (no nssprio support in tc or kernel) the
#       script logs a warning and builds the single queue as without this option;
#     * sqm-autorate: the patched sqm-autorate.pl (qdisc_stats nsstbl, no leaf
#       changes when an nssprio is present) works with this; older versions
#       read the wrong counters. It only knows nssprio: with nsswrr or nsswfq
#       stop it while you test (its leaf change would fail);
#     * if nft refuses the static rules the DSCP rules are loaded without them
#       (warning in the log); nothing is tagged only when nft refuses those too.
#       Which of them are loaded: nft list table inet nss_dscp (every rule has
#       a counter);
#     * the nft rules are also written to ${SQM_STATE_DIR}/<iface>.nss-dscp.nft,
#       with @WAN@ in place of the WAN device. The optional hotplug helper
#       12-sqm-nss loads that file again when the WAN comes up with another
#       device name or the table is gone. Nothing is restarted for that.
#
# The same names in upper case (NSS_WAN_IFACE, ...) work as environment
# variables and take precedence.
################################################################################

. /lib/functions.sh
. ${SQM_LIB_DIR}/defaults.sh

# the maximum (worst case) length of the fq_codel queue in milliseconds, used
# with speed and mtu to compute the queue limit when none is configured
MAXQLIMIT_MS=100

# name of the ingress redirect device created by the nss-ifb module
NSS_IFB=nssifb
# needed here for sqm_stop/sqm_cleanup of sqm-scripts
CUR_IFB=${NSS_IFB}

# mount point of sysfs
SYSFS=${NSS_SYSFS:-/sys}

# init script of sqm-autorate (nihilt/sqm-autorate-nss), see nss_autorate_reload
NSS_AUTORATE_INIT=${NSS_AUTORATE_INIT:-/etc/init.d/sqm-autorate}

# nft table with the tag rules of the DSCP classes (nss_dscp_classes)
NSS_DSCP_TABLE=${NSS_DSCP_TABLE:-nss_dscp}
# nft binary and the defaults of the two class lists
NSS_NFT=${NSS_NFT:-nft}
NSS_DSCP_HIGH_DEFAULT="cs4 cs5 cs6 cs7 ef va"
NSS_DSCP_BULK_DEFAULT="cs1 le"
NSS_DSCP_SCHED_DEFAULT=nssprio
NSS_DSCP_WEIGHTS_DEFAULT="4 2 1"
# most static rules (nss_dscp_match) and values per address or port list
NSS_DSCP_MATCH_MAX=32
NSS_DSCP_LIST_MAX=16
# set by nss_dscp_init / nss_shape_dev
NSS_DSCP_ACTIVE=0
# the static rules, one per line: "CLASS nft-match", and how many
NSS_DSCP_STATIC=
NSS_DSCP_STATIC_N=0

# file the nft rules are also written to (@WAN@ stands for the WAN device);
# 12-sqm-nss reads it
nss_dscp_rules_file() {
    printf '%s' "${NSS_DSCP_RULES:-${SQM_STATE_DIR}/${IFACE}.nss-dscp.nft}"
}

# NSS only works on physical eth devices. Some platforms put the WAN on a
# vlan sub interface (eth0.2): just strip the vlan id for the tc commands.
# IFACE and STATE_FILE are deliberately NOT modified.
NSS_DEV=$(printf '%s' "${IFACE}" | sed 's/\.[0-9][0-9]*$//')

# Should nssifb be deleted on stop/restart?
#   5.10: no, deleting it frequently crashes the kernel (stock script).
#   5.15: yes, the qdisc only works the first time it is attached there, so
#         the interface has to be recreated (stock script).
#   6.18: no. Deleting and recreating nssifb on every restart was suspected of
#         crashing the router now and then. Tested on an R7800 (DSA): about 20
#         back to back restarts, the ingress shaper kept counting after every
#         re-attach, nothing crashed.
#   other kernels: unverified, the stock behaviour (delete) is kept.
# The uci option nss_keep_ifb 0|1 overrides this (nss_apply_keep_ifb).
case "$(uname -r)" in
    5.10|5.10.*|6.18|6.18.*) NSS_KEEP_IFB_DEFAULT=1; DELETENSSIFB= ;;
    *)                       NSS_KEEP_IFB_DEFAULT=0; DELETENSSIFB=1 ;;
esac

###############################################################################
# small helpers
###############################################################################

nss_is_uint() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    return 0
}

# is shell function/command $1 available?
nss_have() {
    command -v "$1" >/dev/null 2>&1
}

# queue limit = (bandwidth / 8 bits) * delay / MTU
calc_limit() {
    local LIMIT
    [ -z "${MINLIMIT}" ] && MINLIMIT=200
    LIMIT=$(awk -v SPEED="$1" -v MTU="$2" -v MAXDELAY="$3" \
        'BEGIN {print(int((SPEED*125)*(MAXDELAY/1000)/MTU))}')
    sqm_debug "calc_limit: queue limit should be ${LIMIT} packets for speed $1, MTU $2 and maximum delay $3 ms"
    if ! nss_is_uint "${LIMIT}" || [ "${LIMIT}" -lt "${MINLIMIT}" ]; then
        LIMIT=${MINLIMIT}
    fi
    echo "${LIMIT}"
}

# ---- UCI -------------------------------------------------------------------

nss_match_section() {
    local iface
    [ -n "${NSS_SECTION}" ] && return 0
    config_get iface "$1" interface
    [ "${iface}" = "${IFACE}" ] && NSS_SECTION="$1"
    return 0
}

# find the sqm queue section that belongs to this interface
nss_uci_load() {
    NSS_SECTION=
    config_load sqm
    config_foreach nss_match_section queue
    sqm_debug "nss_uci_load: sqm section for ${IFACE}: ${NSS_SECTION:-<none>}"
}

# nss_opt VARIABLE uci_option default
# environment variable wins, then the uci option, then the default
nss_opt() {
    local var="$1" opt="$2" def="$3" cur val=
    eval "cur=\${${var}:-}"
    [ -n "${cur}" ] && return 0
    [ -n "${NSS_SECTION}" ] && config_get val "${NSS_SECTION}" "${opt}"
    eval "${var}=\${val:-\${def}}"
    return 0
}

# keep or delete nssifb on stop: nss_keep_ifb (uci/env) or the kernel default.
# Needs NSS_SECTION to be loaded already (nss_uci_load).
nss_apply_keep_ifb() {
    nss_opt NSS_KEEP_IFB nss_keep_ifb "${NSS_KEEP_IFB_DEFAULT}"
    case "${NSS_KEEP_IFB}" in
        0|1) ;;
        *) sqm_warn "nss_keep_ifb '${NSS_KEEP_IFB}' is not 0 or 1, using the default (${NSS_KEEP_IFB_DEFAULT})"
           NSS_KEEP_IFB=${NSS_KEEP_IFB_DEFAULT} ;;
    esac
    if [ "${NSS_KEEP_IFB}" -eq 1 ]; then
        DELETENSSIFB=
        sqm_debug "${NSS_IFB} will not be deleted on stop (nss_keep_ifb=1)"
    else
        DELETENSSIFB=1
        sqm_debug "${NSS_IFB} will be deleted on stop and recreated on start (nss_keep_ifb=0)"
    fi
    return 0
}

###############################################################################
# DSCP classes (nss_dscp_classes)
###############################################################################

# DSCP name or number 1..63 -> number on stdout. DSCP 0 (cs0, best effort) is
# refused: it is what the normal class is for. rc 1: not valid.
nss_dscp_num() {
    case "$1" in
        cs1) echo 8 ;;  cs2) echo 16 ;; cs3) echo 24 ;; cs4) echo 32 ;;
        cs5) echo 40 ;; cs6) echo 48 ;; cs7) echo 56 ;;
        af11) echo 10 ;; af12) echo 12 ;; af13) echo 14 ;;
        af21) echo 18 ;; af22) echo 20 ;; af23) echo 22 ;;
        af31) echo 26 ;; af32) echo 28 ;; af33) echo 30 ;;
        af41) echo 34 ;; af42) echo 36 ;; af43) echo 38 ;;
        ef) echo 46 ;; va) echo 44 ;; le) echo 1 ;;
        0*) return 1 ;;
        [1-9]|[1-9][0-9])
            [ "$1" -le 63 ] || return 1
            echo "$1" ;;
        *) return 1 ;;
    esac
    return 0
}

# nss_dscp_parse OPTION_NAME "LIST" EXCLUDE_CSV
# LIST: DSCP names/numbers separated by spaces (or commas). Result in
# NSS_DSCP_PARSED as "n,n,n" (empty when nothing valid). Numbers listed in
# EXCLUDE_CSV are dropped (they belong to an earlier class). Anything but
# letters, digits, spaces and commas rejects the whole list, so nothing odd can
# ever reach the nft command.
nss_dscp_parse() {
    local what="$1" list="$2" excl="$3" tok n out=

    NSS_DSCP_PARSED=
    list=$(printf '%s' "${list}" | tr 'A-Z,' 'a-z ')
    case "${list}" in
        *[!a-z0-9\ ]*)
            sqm_warn "${what}: only letters, digits, spaces and commas are allowed, ignoring the whole list"
            return 0 ;;
    esac

    # shellcheck disable=SC2086  # word splitting wanted; the characters were checked above
    for tok in ${list}; do
        [ "${tok}" = none ] && continue
        if ! n=$(nss_dscp_num "${tok}"); then
            sqm_warn "${what}: '${tok}' is not a DSCP name or a number from 1 to 63, ignored"
            continue
        fi
        case ",${excl}," in
            *",${n},"*)
                sqm_warn "${what}: DSCP ${n} (${tok}) is already in the high class, ignored"
                continue ;;
        esac
        case ",${out}," in
            *",${n},"*) continue ;;
        esac
        out="${out:+${out},}${n}"
    done
    NSS_DSCP_PARSED=${out}
    return 0
}

# nss_dscp_weights_parse: NSS_DSCP_WEIGHTS is three whole numbers 1-1000 (high,
# normal, bulk); sets NSS_W_HIGH / NSS_W_NORM / NSS_W_BULK. rc 1: not valid.
nss_dscp_weights_parse() {
    local n

    # digits and spaces only: nothing to glob or expand in the split below
    case "${NSS_DSCP_WEIGHTS}" in *[!0-9\ ]*) return 1 ;; esac
    # shellcheck disable=SC2086  # the list is intentionally word split
    set -- ${NSS_DSCP_WEIGHTS}
    [ $# -eq 3 ] || return 1
    for n in "$@"; do
        nss_is_uint "${n}" || return 1
        case "${n}" in 0*) return 1 ;; esac
        [ "${#n}" -le 4 ] && [ "${n}" -le 1000 ] || return 1
    done
    NSS_W_HIGH=$1; NSS_W_NORM=$2; NSS_W_BULK=$3
    return 0
}

# ---- static rules (nss_dscp_match) -----------------------------------------
# The option is cut into words and checked word by word; only forms that nft
# is known to take are accepted, and everything that reaches the nft script is
# made of the characters a-z 0-9 . : , / - and spaces.

# nss_m_reset: forget the rule that was being read
nss_m_reset() {
    NSS_M_CLS=; NSS_M_PROTO=; NSS_M_PORTOK=1; NSS_M_FAM=
    NSS_M_SADDR=; NSS_M_DADDR=; NSS_M_SPORT=; NSS_M_DPORT=
    NSS_M_WANT=; NSS_M_ERR=; NSS_M_TEXT=
}

# one port: 1-65535, no sign, no leading zero
nss_m_port() {
    case "$1" in ''|0*|*[!0-9]*) return 1 ;; esac
    [ "${#1}" -le 5 ] && [ "$1" -le 65535 ]
}

# nss_m_ports "80,443,50000-50100" -> NSS_M_OUT "80, 443, 50000-50100"
nss_m_ports() {
    local e lo hi out=

    NSS_M_OUT=
    # shellcheck disable=SC2046  # only digits, "-" and "," can be here
    set -- $(printf '%s' "$1" | tr ',' ' ')
    [ $# -ge 1 ] && [ $# -le "${NSS_DSCP_LIST_MAX}" ] || return 1
    for e in "$@"; do
        case "${e}" in
            *-*) lo=${e%%-*}; hi=${e#*-} ;;
            *)   lo=${e}; hi=${e} ;;
        esac
        nss_m_port "${lo}" && nss_m_port "${hi}" || return 1
        [ "${lo}" -le "${hi}" ] || return 1
        [ "${lo}" -eq "${hi}" ] && e=${lo}
        out="${out:+${out}, }${e}"
    done
    NSS_M_OUT=${out}
    return 0
}

# a.b.c.d or a.b.c.d/n
nss_m_v4() {
    local IFS=. a="$1" p= o

    case "${a}" in
        */*) p=${a#*/}; a=${a%%/*}
             case "${p}" in ''|0?*|*[!0-9]*) return 1 ;; esac
             [ "${#p}" -le 2 ] && [ "${p}" -le 32 ] || return 1 ;;
    esac
    case "${a}" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
    # shellcheck disable=SC2086  # only digits and dots can be here
    set -- ${a}
    [ $# -eq 4 ] || return 1
    for o in "$@"; do
        case "${o}" in ''|0?*) return 1 ;; esac
        [ "${#o}" -le 3 ] && [ "${o}" -le 255 ] || return 1
    done
    return 0
}

# IPv6 address or prefix, lower case hex groups, "::" at most once, no dotted
# IPv4 tail
nss_m_v6() {
    local IFS=: a="$1" p= pre post dbl=0 g

    case "${a}" in
        */*) p=${a#*/}; a=${a%%/*}
             case "${p}" in ''|0?*|*[!0-9]*) return 1 ;; esac
             [ "${#p}" -le 3 ] && [ "${p}" -le 128 ] || return 1 ;;
    esac
    case "${a}" in ''|*[!0-9a-f:]*|*:::*) return 1 ;; esac
    case "${a}" in
        *::*) pre=${a%%::*}; post=${a#*::}
              case "${post}" in *::*) return 1 ;; esac
              dbl=1 ;;
        *)    pre=${a}; post= ;;
    esac
    # a single colon at an end is not "::"
    case "${pre}" in :*|*:) return 1 ;; esac
    case "${post}" in :*|*:) return 1 ;; esac
    # shellcheck disable=SC2086  # only hex digits and colons can be here
    set -- ${pre} ${post}
    for g in "$@"; do
        [ "${#g}" -le 4 ] || return 1
    done
    if [ "${dbl}" -eq 1 ]; then
        [ $# -le 7 ]
    else
        [ $# -eq 8 ]
    fi
}

# nss_m_addrs "LIST": addresses or prefixes of one IP version
# -> NSS_M_OUT "a, b" and NSS_M_AF (ip or ip6)
nss_m_addrs() {
    local e out= af= v

    NSS_M_OUT=; NSS_M_AF=
    # shellcheck disable=SC2046  # only a-z 0-9 . : / - and "," can be here
    set -- $(printf '%s' "$1" | tr ',' ' ')
    [ $# -ge 1 ] && [ $# -le "${NSS_DSCP_LIST_MAX}" ] || return 1
    for e in "$@"; do
        case "${e}" in
            *:*) nss_m_v6 "${e}" || return 1; v=ip6 ;;
            *)   nss_m_v4 "${e}" || return 1; v=ip ;;
        esac
        [ -z "${af}" ] || [ "${af}" = "${v}" ] || return 1
        af=${v}
        out="${out:+${out}, }${e}"
    done
    NSS_M_OUT=${out}; NSS_M_AF=${af}
    return 0
}

# nss_m_proto "tcp,udp" -> NSS_M_PROTO "6, 17" (protocol numbers); NSS_M_PORTOK
# is 0 when something else than tcp and udp is in it
nss_m_proto() {
    local p q n out=

    NSS_M_PROTO=; NSS_M_PORTOK=1
    # shellcheck disable=SC2046  # only a-z and "," can be here
    set -- $(printf '%s' "$1" | tr ',' ' ')
    [ $# -ge 1 ] && [ $# -le 6 ] || return 1
    for p in "$@"; do
        case "${p}" in
            tcp)  n=6 ;;
            udp)  n=17 ;;
            icmp) n="1 58"; NSS_M_PORTOK=0 ;;
            esp)  n=50;  NSS_M_PORTOK=0 ;;
            gre)  n=47;  NSS_M_PORTOK=0 ;;
            sctp) n=132; NSS_M_PORTOK=0 ;;
            *) return 1 ;;
        esac
        for q in ${n}; do
            case ", ${out}, " in
                *", ${q}, "*) ;;
                *) out="${out:+${out}, }${q}" ;;
            esac
        done
    done
    NSS_M_PROTO=${out}
    return 0
}

# is the keyword $1 (saddr daddr sport dport) already set in this rule?
nss_m_have() {
    case "$1" in
        saddr) [ -n "${NSS_M_SADDR}" ] ;;
        daddr) [ -n "${NSS_M_DADDR}" ] ;;
        sport) [ -n "${NSS_M_SPORT}" ] ;;
        *)     [ -n "${NSS_M_DPORT}" ] ;;
    esac
}

# nss_m_value KEYWORD WORD: the value of saddr, daddr, sport or dport
nss_m_value() {
    case "$1" in
        saddr|daddr)
            if ! nss_m_addrs "$2"; then
                NSS_M_ERR="'$2' is not a list of IPv4 or IPv6 addresses or prefixes (one version per list, at most ${NSS_DSCP_LIST_MAX})"
                return 0
            fi
            if [ -n "${NSS_M_FAM}" ] && [ "${NSS_M_FAM}" != "${NSS_M_AF}" ]; then
                NSS_M_ERR="saddr and daddr must be of the same IP version"
                return 0
            fi
            NSS_M_FAM=${NSS_M_AF}
            if [ "$1" = saddr ]; then NSS_M_SADDR=${NSS_M_OUT}; else NSS_M_DADDR=${NSS_M_OUT}; fi ;;
        *)
            if ! nss_m_ports "$2"; then
                NSS_M_ERR="'$2' is not a list of ports 1-65535 or ranges (at most ${NSS_DSCP_LIST_MAX})"
                return 0
            fi
            if [ "$1" = sport ]; then NSS_M_SPORT=${NSS_M_OUT}; else NSS_M_DPORT=${NSS_M_OUT}; fi ;;
    esac
    return 0
}

# the rule that was read so far is complete: check it and add it
nss_m_finish() {
    local expr=

    [ -n "${NSS_M_TEXT}" ] || return 0
    if [ -z "${NSS_M_ERR}" ] && [ -n "${NSS_M_WANT}" ]; then
        NSS_M_ERR="'${NSS_M_WANT}' needs a value"
    fi
    if [ -z "${NSS_M_ERR}" ] && [ -z "${NSS_M_PROTO}${NSS_M_SADDR}${NSS_M_DADDR}${NSS_M_SPORT}${NSS_M_DPORT}" ]; then
        NSS_M_ERR="no protocol, address or port, that would match everything"
    fi
    if [ -z "${NSS_M_ERR}" ] && { [ -n "${NSS_M_SPORT}" ] || [ -n "${NSS_M_DPORT}" ]; }; then
        if [ -z "${NSS_M_PROTO}" ]; then
            NSS_M_PROTO="6, 17"
        elif [ "${NSS_M_PORTOK}" -ne 1 ]; then
            NSS_M_ERR="ports go with tcp and udp only"
        fi
    fi
    if [ -z "${NSS_M_ERR}" ] && [ "${NSS_DSCP_STATIC_N}" -ge "${NSS_DSCP_MATCH_MAX}" ]; then
        NSS_M_ERR="more than ${NSS_DSCP_MATCH_MAX} rules"
    fi
    if [ -n "${NSS_M_ERR}" ]; then
        sqm_warn "nss_dscp_match: ignoring '${NSS_M_TEXT}': ${NSS_M_ERR}"
        return 0
    fi

    [ -n "${NSS_M_PROTO}" ] && expr="meta l4proto { ${NSS_M_PROTO} }"
    [ -n "${NSS_M_SADDR}" ] && expr="${expr:+${expr} }${NSS_M_FAM} saddr { ${NSS_M_SADDR} }"
    [ -n "${NSS_M_DADDR}" ] && expr="${expr:+${expr} }${NSS_M_FAM} daddr { ${NSS_M_DADDR} }"
    [ -n "${NSS_M_SPORT}" ] && expr="${expr:+${expr} }th sport { ${NSS_M_SPORT} }"
    [ -n "${NSS_M_DPORT}" ] && expr="${expr:+${expr} }th dport { ${NSS_M_DPORT} }"
    NSS_DSCP_STATIC="${NSS_DSCP_STATIC:+${NSS_DSCP_STATIC}
}${NSS_M_CLS} ${expr}"
    NSS_DSCP_STATIC_N=$((NSS_DSCP_STATIC_N + 1))
    return 0
}

# nss_dscp_match_parse: NSS_DSCP_MATCH -> NSS_DSCP_STATIC / NSS_DSCP_STATIC_N.
# A rule starts at each of the words high, normal and bulk, so the rules can be
# separated by anything: a uci list (joined by spaces), ";" or new lines.
nss_dscp_match_parse() {
    local list tok

    NSS_DSCP_STATIC=
    NSS_DSCP_STATIC_N=0
    [ -n "${NSS_DSCP_MATCH}" ] || return 0

    list=$(printf '%s' "${NSS_DSCP_MATCH}" | tr 'A-Z;\n\t\r' 'a-z    ')
    case "${list}" in
        *[!a-z0-9\ .:,/-]*)
            sqm_warn "nss_dscp_match: only letters, digits, spaces and . : , / - ; are allowed, ignoring all static rules"
            return 0 ;;
    esac

    nss_m_reset
    # shellcheck disable=SC2086  # word splitting wanted; the characters were checked above
    set -- ${list}
    for tok in "$@"; do
        case "${tok}" in
            high|normal|bulk)
                nss_m_finish
                nss_m_reset
                NSS_M_CLS=${tok}; NSS_M_TEXT=${tok}
                continue ;;
        esac
        NSS_M_TEXT="${NSS_M_TEXT:+${NSS_M_TEXT} }${tok}"
        [ -z "${NSS_M_ERR}" ] || continue
        if [ -z "${NSS_M_CLS}" ]; then
            NSS_M_ERR="a rule starts with high, normal or bulk"
            continue
        fi
        if [ -n "${NSS_M_WANT}" ]; then
            nss_m_value "${NSS_M_WANT}" "${tok}"
            NSS_M_WANT=
            continue
        fi
        case "${tok}" in
            saddr|daddr|sport|dport)
                if nss_m_have "${tok}"; then
                    NSS_M_ERR="'${tok}' given twice"
                else
                    NSS_M_WANT=${tok}
                fi ;;
            *)
                if [ -n "${NSS_M_PROTO}" ]; then
                    NSS_M_ERR="'${tok}': the protocol is already given"
                elif ! nss_m_proto "${tok}"; then
                    NSS_M_ERR="'${tok}' is not tcp, udp, icmp, esp, gre, sctp, saddr, daddr, sport or dport"
                fi ;;
        esac
    done
    nss_m_finish
    nss_m_reset
    sqm_debug "nss_dscp_match_parse: ${NSS_DSCP_STATIC_N} static rule(s)"
    return 0
}

# read and validate the nss_dscp_* options. Needs nss_uci_load first.
nss_dscp_init() {
    NSS_DSCP_ACTIVE=0
    NSS_DSCP_HIGH_NUMS=
    NSS_DSCP_BULK_NUMS=
    NSS_DSCP_STATIC=
    NSS_DSCP_STATIC_N=0

    nss_opt NSS_DSCP_CLASSES nss_dscp_classes 0
    case "${NSS_DSCP_CLASSES}" in
        0|1) ;;
        *) sqm_warn "nss_dscp_classes '${NSS_DSCP_CLASSES}' is not 0 or 1, using the default (0)"
           NSS_DSCP_CLASSES=0 ;;
    esac
    [ "${NSS_DSCP_CLASSES}" -eq 1 ] || return 0

    nss_opt NSS_DSCP_HIGH    nss_dscp_high    "${NSS_DSCP_HIGH_DEFAULT}"
    nss_opt NSS_DSCP_BULK    nss_dscp_bulk    "${NSS_DSCP_BULK_DEFAULT}"
    nss_opt NSS_DSCP_WAN_DEV nss_dscp_wan_dev ""

    nss_dscp_parse nss_dscp_high "${NSS_DSCP_HIGH}" ""
    NSS_DSCP_HIGH_NUMS=${NSS_DSCP_PARSED}
    nss_dscp_parse nss_dscp_bulk "${NSS_DSCP_BULK}" "${NSS_DSCP_HIGH_NUMS}"
    NSS_DSCP_BULK_NUMS=${NSS_DSCP_PARSED}
    sqm_debug "nss_dscp_init: high='${NSS_DSCP_HIGH_NUMS}' bulk='${NSS_DSCP_BULK_NUMS}'"

    nss_opt NSS_DSCP_SCHED nss_dscp_sched "${NSS_DSCP_SCHED_DEFAULT}"
    NSS_DSCP_SCHED=$(printf '%s' "${NSS_DSCP_SCHED}" | tr 'A-Z' 'a-z')
    case "${NSS_DSCP_SCHED}" in
        nssprio|nsswrr|nsswfq) ;;
        *) sqm_warn "nss_dscp_sched '${NSS_DSCP_SCHED}' is not nssprio, nsswrr or nsswfq, using nssprio"
           NSS_DSCP_SCHED=nssprio ;;
    esac
    nss_opt NSS_DSCP_WEIGHTS nss_dscp_weights "${NSS_DSCP_WEIGHTS_DEFAULT}"
    if ! nss_dscp_weights_parse; then
        sqm_warn "nss_dscp_weights '${NSS_DSCP_WEIGHTS}' is not three whole numbers 1-1000, using ${NSS_DSCP_WEIGHTS_DEFAULT}"
        NSS_DSCP_WEIGHTS=${NSS_DSCP_WEIGHTS_DEFAULT}
        nss_dscp_weights_parse
    fi
    sqm_debug "nss_dscp_init: sched ${NSS_DSCP_SCHED}, weights ${NSS_W_HIGH}:${NSS_W_NORM}:${NSS_W_BULK}"

    nss_opt NSS_DSCP_MATCH nss_dscp_match ""
    nss_dscp_match_parse
    return 0
}

nss_init_config() {
    nss_uci_load

    nss_opt ROOT_BURST_UP      root_burst_up      ""
    nss_opt ROOT_BURST_DOWN    root_burst_down    ""
    nss_opt NSS_WAIT_TIMEOUT   nss_wait_timeout   30
    nss_opt NSS_WAN_IFACE      nss_wan_iface      wan
    nss_opt NSS_WAN_TIMEOUT    nss_wan_timeout    20
    nss_opt NSS_WAN_REQUIRED   nss_wan_required   0
    nss_opt NSS_START_ATTEMPTS nss_start_attempts 3
    nss_opt NSS_RELOAD_AUTORATE nss_reload_autorate 1
    nss_apply_keep_ifb

    nss_is_uint "${NSS_WAIT_TIMEOUT}"   || NSS_WAIT_TIMEOUT=30
    nss_is_uint "${NSS_WAN_TIMEOUT}"    || NSS_WAN_TIMEOUT=20
    nss_is_uint "${NSS_WAN_REQUIRED}"   || NSS_WAN_REQUIRED=0
    nss_is_uint "${NSS_START_ATTEMPTS}" || NSS_START_ATTEMPTS=3
    case "${NSS_RELOAD_AUTORATE}" in
        0|1) ;;
        *) sqm_warn "nss_reload_autorate '${NSS_RELOAD_AUTORATE}' is not 0 or 1, using the default (1)"
           NSS_RELOAD_AUTORATE=1 ;;
    esac
    [ "${NSS_START_ATTEMPTS}" -ge 1 ]   || NSS_START_ATTEMPTS=1
    if [ -n "${ROOT_BURST_UP}" ] && { ! nss_is_uint "${ROOT_BURST_UP}" || [ "${ROOT_BURST_UP}" -eq 0 ]; }; then
        sqm_warn "root_burst_up '${ROOT_BURST_UP}' is not a positive number of bytes, ignoring it"
        ROOT_BURST_UP=
    fi
    if [ -n "${ROOT_BURST_DOWN}" ] && { ! nss_is_uint "${ROOT_BURST_DOWN}" || [ "${ROOT_BURST_DOWN}" -eq 0 ]; }; then
        sqm_warn "root_burst_down '${ROOT_BURST_DOWN}' is not a positive number of bytes, ignoring it"
        ROOT_BURST_DOWN=
    fi

    if ! nss_is_uint "${UPLINK}" || ! nss_is_uint "${DOWNLINK}"; then
        sqm_error "upload ('${UPLINK}') and download ('${DOWNLINK}') must be whole numbers in kbit/s"
        return 1
    fi

    # the NSS qdiscs are fq_codel only; the sqm helpers (get_quantum, get_limit,
    # get_target) key off $QDISC, so make sure they behave accordingly
    case "${QDISC}" in
        fq_codel) ;;
        *) sqm_warn "the NSS shaper only supports fq_codel, ignoring queue discipline '${QDISC}'"
           QDISC=fq_codel ;;
    esac

    # nss-ifb only works on the eth (GMAC) devices. On DSA builds the WAN
    # port "wan" is only a user port; the traffic of it flows through eth0.
    case "${NSS_DEV}" in
        eth[0-9]*) ;;
        *) sqm_warn "'${NSS_DEV}' is not an eth device. The NSS shaper only works on the eth devices (eth0 on the R7800), not on DSA ports such as wan/lan1, bridges or ppp interfaces; select eth0 in the SQM interface setting" ;;
    esac

    nss_dscp_init
    return 0
}

###############################################################################
# preflight: tc and kernel module support
###############################################################################

nss_preflight() {
    local tcbin out q

    tcbin=${TC_BINARY:-$(command -v tc)}
    if [ -z "${tcbin}" ] || [ ! -x "${tcbin}" ]; then
        sqm_error "no tc binary found"
        return 1
    fi

    # "help" makes tc parse the qdisc name and print its usage without sending
    # anything to the kernel. A tc without NSS support answers
    # 'Unknown qdisc "nsstbl", hence option "help" is unparsable'.
    for q in nsstbl nssfq_codel; do
        out=$("${tcbin}" qdisc add dev lo root handle 1: "${q}" help 2>&1)
        case "${out}" in
            *"Unknown qdisc"*)
                sqm_error "${tcbin} (-> $(readlink -f "${tcbin}" 2>/dev/null)) has no support for the NSS qdisc '${q}'."
                sqm_error "It is probably tc-full/tc-bpf from the stock OpenWrt feed replacing the NSS patched tc (tc-tiny). Reinstall the tc from your NSS image."
                return 1 ;;
        esac
    done

    # the DSCP classes need nssprio as well; without it the feature is dropped,
    # the shaper itself still starts
    if [ "${NSS_DSCP_CLASSES:-0}" -eq 1 ]; then
        out=$("${tcbin}" qdisc add dev lo root handle 1: nssprio help 2>&1)
        case "${out}" in
            *"Unknown qdisc"*)
                sqm_warn "${tcbin} has no support for the NSS qdisc 'nssprio': DSCP classes are disabled"
                NSS_DSCP_CLASSES=0 ;;
        esac
    fi
    # ... and the scheduler asked for, if it is another one: fall back to nssprio
    if [ "${NSS_DSCP_CLASSES:-0}" -eq 1 ] && [ "${NSS_DSCP_SCHED:-nssprio}" != nssprio ]; then
        out=$("${tcbin}" qdisc add dev lo root handle 1: "${NSS_DSCP_SCHED}" help 2>&1)
        case "${out}" in
            *"Unknown qdisc"*)
                sqm_warn "${tcbin} has no support for the NSS qdisc '${NSS_DSCP_SCHED}': using nssprio"
                NSS_DSCP_SCHED=nssprio ;;
        esac
    fi

    # kernel side: autoloaded normally, try to load it if it is not
    if [ ! -d "${SYSFS}/module/qca_nss_qdisc" ]; then
        sqm_debug "nss_preflight: qca-nss-qdisc not loaded, trying to load it"
        ${INSMOD} qca-nss-qdisc 2>>"${OUTPUT_TARGET}"
        [ -d "${SYSFS}/module/qca_nss_qdisc" ] || \
            sqm_warn "kernel module qca-nss-qdisc not found in sysfs (kmod-qca-nss-drv-qdisc installed? built in?); continuing"
    fi
    return 0
}

###############################################################################
# readiness: eth device up, logical WAN up
###############################################################################

# device exists and is administratively up (IFF_UP in /sys/class/net/x/flags)
nss_dev_ready() {
    local flags
    [ -d "${SYSFS}/class/net/$1" ] || return 1
    flags=$(cat "${SYSFS}/class/net/$1/flags" 2>/dev/null)
    [ -n "${flags}" ] || return 1
    [ $(( flags & 1 )) -eq 1 ]
}

# 0: up and has an address, 1: not ready (yet), 2: no such interface
nss_wan_state() {
    local json up addr
    json=$(ubus call "network.interface.$1" status 2>/dev/null) || return 2
    up=$(printf '%s' "${json}" | jsonfilter -e '@.up' 2>/dev/null)
    case "${up}" in
        true|1) ;;
        *) return 1 ;;
    esac
    addr=$(printf '%s' "${json}" | jsonfilter \
        -e '@["ipv4-address"][0].address' \
        -e '@["ipv6-address"][0].address' \
        -e '@["ipv6-prefix"][0].address' 2>/dev/null)
    [ -n "${addr}" ]
}

nss_wait_ready() {
    local i=0 nf=0 rc

    # 1. the eth device (hard requirement)
    while ! nss_dev_ready "${NSS_DEV}"; do
        if [ "${i}" -ge "${NSS_WAIT_TIMEOUT}" ]; then
            sqm_error "${NSS_DEV} does not exist or is not up after ${NSS_WAIT_TIMEOUT}s, not starting"
            return 1
        fi
        [ "${i}" -eq 0 ] && sqm_log "waiting up to ${NSS_WAIT_TIMEOUT}s for ${NSS_DEV} to come up.."
        sleep 1
        i=$((i + 1))
    done
    sqm_debug "nss_wait_ready: ${NSS_DEV} is up"

    # 2. the logical WAN interface (soft requirement)
    case "${NSS_WAN_IFACE}" in
        ''|none|off|0)
            sqm_debug "nss_wait_ready: logical WAN check disabled"
            return 0 ;;
    esac
    if ! nss_have ubus || ! nss_have jsonfilter; then
        sqm_debug "nss_wait_ready: ubus/jsonfilter not available, skipping the logical WAN check"
        return 0
    fi

    i=0
    while :; do
        nss_wan_state "${NSS_WAN_IFACE}"
        rc=$?
        if [ "${rc}" -eq 0 ]; then
            sqm_debug "nss_wait_ready: logical interface ${NSS_WAN_IFACE} is up"
            return 0
        fi
        if [ "${rc}" -eq 2 ]; then
            nf=$((nf + 1))
            if [ "${nf}" -ge 5 ]; then
                sqm_warn "logical interface '${NSS_WAN_IFACE}' does not exist, not waiting for it (set nss_wan_iface to your WAN interface, or to 'none')"
                return 0
            fi
        fi
        if [ "${i}" -ge "${NSS_WAN_TIMEOUT}" ]; then
            if [ "${NSS_WAN_REQUIRED}" -ne 0 ]; then
                sqm_error "WAN interface '${NSS_WAN_IFACE}' is not up after ${NSS_WAN_TIMEOUT}s and nss_wan_required is set, not starting"
                return 1
            fi
            sqm_warn "WAN interface '${NSS_WAN_IFACE}' is not up after ${NSS_WAN_TIMEOUT}s, shaping ${NSS_DEV} anyway"
            return 0
        fi
        [ "${i}" -eq 0 ] && sqm_log "waiting up to ${NSS_WAN_TIMEOUT}s for WAN interface ${NSS_WAN_IFACE}.."
        sleep 1
        i=$((i + 1))
    done
}

###############################################################################
# the shapers
###############################################################################

# is an NSS shaper (nsstbl) installed on device $1?
nss_has_shaper() {
    "${TC_BINARY:-tc}" qdisc show dev "$1" 2>/dev/null | grep -q 'qdisc nsstbl'
}

# is the configured shaping in place on all devices?
nss_shaper_present() {
    nss_is_uint "${UPLINK}"   || return 1
    nss_is_uint "${DOWNLINK}" || return 1
    [ -d "${SYSFS}/class/net/${NSS_DEV}" ] || return 1
    [ "${UPLINK}" -eq 0 ] || nss_has_shaper "${NSS_DEV}" || return 1
    [ "${DOWNLINK}" -eq 0 ] && return 0
    [ -d "${SYSFS}/class/net/${NSS_IFB}" ] && nss_has_shaper "${NSS_IFB}"
}

# nsstbl (token bucket limiter)
# add_nsstbl DEV SPEED_KBIT BURST_BYTES(or empty) BURST_US MTU
add_nsstbl() {
    local dev="$1" speed="$2" rburst="$3" burst_us="$4" mtu="$5" burst

    if [ -n "${rburst}" ]; then
        # explicit value from uci: use exactly that (but at least one packet)
        burst=${rburst}
        [ "${burst}" -lt "${mtu}" ] && burst=${mtu}
    else
        # burst is a tradeoff between cpu load and strictness of the shaper;
        # the sqm default of 1000us works well, rounded to a multiple of the mtu
        burst=$(get_burst "${mtu}" "${speed}" "${burst_us}")
        burst=$(echo "${burst}" | awk -v MTU="${mtu}" \
            '{b = sprintf("%.0f", $0 / MTU) * MTU; if (b < MTU) b = MTU; print b}')
    fi
    sqm_debug "add_nsstbl ${dev}: speed:${speed} burst:${burst} mtu:${mtu}"

    $TC qdisc add dev "${dev}" root handle 1: nsstbl rate "${speed}kbit" burst "${burst}" mtu "${mtu}b" || return 1
    NSS_LAST_BURST=${burst}
    return 0
}

# arguments of a nssfq_codel leaf, left in NSS_LEAF_ARGS
# nss_leaf_args DEV SPEED_KBIT TARGET LIMIT MTU OPTS
nss_leaf_args() {
    local dev="$1" speed="$2" target="$3" limit="$4" mtu="$5" opts="$6"
    local q lim tgt

    sqm_debug "nss_leaf_args ${dev}: speed:${speed} target:${target} limit:${limit} mtu:${mtu} opts:${opts}"

    # codel interval: should be the average worst case latency to your services
    case " ${opts} " in
        *" interval "*) ;;
        *) opts="interval 100ms ${opts}" ;;
    esac

    # quantum: bytes dequeued at once; below 100 Mbit a small quantum gives
    # small packets more weight
    case " ${opts} " in
        *" quantum "*) ;;
        *) q=${mtu}
           [ "${speed}" -lt 100000 ] && q=$(( q / 5 + 1 ))
           opts="$(get_quantum "${q}") ${opts}" ;;
    esac

    # flows is required by nssfq_codel
    case " ${opts} " in
        *" flows "*) ;;
        *) opts="flows 1024 ${opts}" ;;
    esac

    # computed limit/target only when the user did not give their own
    case " ${opts} " in
        *" limit "*) lim= ;;
        *) lim=$(get_limit "${limit}") ;;
    esac
    case " ${opts} " in
        *" target "*) tgt= ;;
        *) tgt=$(get_target "${target}" "${speed}") ;;
    esac

    NSS_LEAF_ARGS="${lim} ${tgt} ${opts}"
    return 0
}

# nssfq_codel child
# add_nssfq_codel DEV SPEED_KBIT TARGET LIMIT MTU OPTS
add_nssfq_codel() {
    nss_leaf_args "$@"
    # shellcheck disable=SC2086  # options are intentionally word split
    $TC qdisc add dev "$1" parent 1: handle 10: nssfq_codel ${NSS_LEAF_ARGS} set_default || return 1
    return 0
}

# DSCP classes: nsstbl 1: -> a scheduler 10: with three nssfq_codel leaves. The
# firmware sends a flow to the leaf whose HANDLE equals the flow's tag (11:0 and
# 13:0 are set by nss_dscp_apply); everything else, untagged traffic included,
# goes to the set_default leaf 12:.
#   10:1 -> 11: high    10:2 -> 12: normal (default)    10:3 -> 13: bulk
# The scheduler is nssprio (three bands) or, opt-in, nsswrr / nsswfq
# with three classes 10:1-10:3 weighted by nss_dscp_weights.
# add_nss_classes SCHED DEV SPEED_KBIT TARGET LIMIT MTU OPTS
add_nss_classes() {
    local sched="$1" dev w c=1

    shift
    dev="$1"
    nss_leaf_args "$@"
    case "${sched}" in
        nssprio)
            $TC qdisc add dev "${dev}" parent 1: handle 10: nssprio bands 3 || return 1 ;;
        nsswrr|nsswfq)
            $TC qdisc add dev "${dev}" parent 1: handle 10: "${sched}" || return 1
            for w in ${NSS_W_HIGH} ${NSS_W_NORM} ${NSS_W_BULK}; do
                # wrr: quantum in packets; wfq: in bytes
                [ "${sched}" = nsswfq ] && w=$(( w * 1500 ))
                $TC class add dev "${dev}" parent 10: classid "10:${c}" "${sched}" quantum "${w}" || return 1
                c=$(( c + 1 ))
            done ;;
        *) return 1 ;;
    esac
    # shellcheck disable=SC2086  # options are intentionally word split
    $TC qdisc add dev "${dev}" parent 10:1 handle 11: nssfq_codel ${NSS_LEAF_ARGS} || return 1
    # shellcheck disable=SC2086
    $TC qdisc add dev "${dev}" parent 10:2 handle 12: nssfq_codel ${NSS_LEAF_ARGS} set_default || return 1
    # shellcheck disable=SC2086
    $TC qdisc add dev "${dev}" parent 10:3 handle 13: nssfq_codel ${NSS_LEAF_ARGS} || return 1
    return 0
}

# MTU of $1 as seen by the NSS shaper (device mtu + ethernet/NSS overhead)
nss_mtu() {
    local m ov
    m=$(cat "${SYSFS}/class/net/$1/mtu" 2>/dev/null)
    if ! nss_is_uint "${m}" || [ "${m}" -eq 0 ]; then
        sqm_warn "cannot read the MTU of $1, assuming 1500"
        m=1500
    fi
    # Without an explicit overhead use 18: maxpacket shows 1518 byte packets
    # hitting the shaper (14 ethernet + 4 NSS)
    ov=${OVERHEAD:-0}
    nss_is_uint "${ov}" || ov=0
    [ "${ov}" -eq 0 ] && ov=18
    echo $(( m + ov ))
}

# nss_shape_dev DEV SPEED TARGET LIMIT(or empty) OPTS BURST_BYTES(or empty) BURST_US [CLASSES 0|1]
nss_shape_dev() {
    local dev="$1" speed="$2" target="$3" limit="$4" opts="$5" rburst="$6" burst_us="$7" classes="${8:-0}"
    local mtu info= sched built=

    mtu=$(nss_mtu "${dev}")
    [ -z "${limit}" ] && limit=$(calc_limit "${speed}" "${mtu}" "${MAXQLIMIT_MS}")

    # idempotent: drop whatever is left from an earlier run
    SILENT=1 $TC qdisc del dev "${dev}" root

    add_nsstbl "${dev}" "${speed}" "${rburst}" "${burst_us}" "${mtu}" || return 1
    if [ "${classes}" -eq 1 ]; then
        sched=${NSS_DSCP_SCHED:-nssprio}
        add_nss_classes "${sched}" "${dev}" "${speed}" "${target}" "${limit}" "${mtu}" "${opts}" && built=${sched}
        if [ -z "${built}" ] && [ "${sched}" != nssprio ]; then
            # an experimental scheduler that does not build: the proven one next
            sqm_warn "could not build the ${sched} DSCP classes on ${dev}, trying nssprio"
            SILENT=1 $TC qdisc del dev "${dev}" root
            add_nsstbl "${dev}" "${speed}" "${rburst}" "${burst_us}" "${mtu}" || return 1
            add_nss_classes nssprio "${dev}" "${speed}" "${target}" "${limit}" "${mtu}" "${opts}" && built=nssprio
        fi
        if [ -n "${built}" ]; then
            NSS_DSCP_ACTIVE=1
            info=", DSCP classes high/normal/bulk"
            [ "${built}" = nssprio ] || info="${info} (${built} ${NSS_W_HIGH}:${NSS_W_NORM}:${NSS_W_BULK})"
        else
            # the classes are an extra: never lose the shaper over them
            sqm_warn "could not build the DSCP classes on ${dev}, using a single queue instead"
            SILENT=1 $TC qdisc del dev "${dev}" root
            add_nsstbl "${dev}" "${speed}" "${rburst}" "${burst_us}" "${mtu}" || return 1
            add_nssfq_codel "${dev}" "${speed}" "${target}" "${limit}" "${mtu}" "${opts}" || return 1
        fi
    else
        add_nssfq_codel "${dev}" "${speed}" "${target}" "${limit}" "${mtu}" "${opts}" || return 1
    fi
    sqm_log "NSS shaper on ${dev}: ${speed} kbit/s, burst ${NSS_LAST_BURST} bytes, mtu ${mtu}${info}"
    return 0
}

nss_egress() {
    [ -z "${ETARGET}" ] && ETARGET="5ms"
    nss_shape_dev "${NSS_DEV}" "${UPLINK}" "${ETARGET}" "${ELIMIT}" "${EQDISC_OPTS}" \
        "${ROOT_BURST_UP}" "${ESHAPER_BURST_DUR_US}" "${NSS_DSCP_CLASSES:-0}" || { sqm_error "egress: failed to set up the NSS shaper on ${NSS_DEV}"; return 1; }
    return 0
}

nss_ingress() {
    [ -z "${ITARGET}" ] && ITARGET="5ms"
    nss_shape_dev "${NSS_IFB}" "${DOWNLINK}" "${ITARGET}" "${ILIMIT}" "${IQDISC_OPTS}" \
        "${ROOT_BURST_DOWN}" "${ISHAPER_BURST_DUR_US}" || { sqm_error "ingress: failed to set up the NSS shaper on ${NSS_IFB}"; return 1; }

    # The system likes to crash at this point, especially at high load.
    # Sleep a little, hopefully this prevents a crash on restart of sqm.
    sqm_debug "ingress: sleeping for a second before enabling ${NSS_IFB}.."
    sleep 1
    sqm_debug "ingress: enabling ${NSS_IFB}.."
    $IP link set up dev "${NSS_IFB}" || { sqm_error "ingress: cannot bring up ${NSS_IFB}"; return 1; }
    return 0
}

###############################################################################
# DSCP tag rules (nft)
#
# One chain on the forward hook; packets leaving through the WAN device get
# skb->priority set to the handle of their class. ECM records that value when
# it accelerates the flow and the NSS firmware queues the flow in the leaf with
# that handle. Only the exact handles 11:0 and 13:0 are ever written: a tag that
# equals a band or class id (10:1 ...) must be avoided.
###############################################################################

# WAN device name for the oifname match, or nothing
nss_dscp_wan_dev() {
    local dev="${NSS_DSCP_WAN_DEV}" json

    if [ -z "${dev}" ]; then
        case "${NSS_WAN_IFACE}" in
            ''|none|off|0) return 1 ;;
        esac
        nss_have ubus && nss_have jsonfilter || return 1
        json=$(ubus call "network.interface.${NSS_WAN_IFACE}" status 2>/dev/null) || return 1
        dev=$(printf '%s' "${json}" | jsonfilter -e '@.l3_device' 2>/dev/null)
    fi
    # a plain interface name only: it ends up inside quotes in the nft ruleset
    case "${dev}" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#dev}" -le 15 ] || return 1
    printf '%s' "${dev}"
}

# the tag rules only (the rules file stays)
nss_dscp_remove_table() {
    nss_have "${NSS_NFT}" || return 0
    "${NSS_NFT}" delete table inet "${NSS_DSCP_TABLE}" >/dev/null 2>&1
    return 0
}

# the tag rules and the rules file
nss_dscp_remove() {
    local file
    file=$(nss_dscp_rules_file)
    rm -f "${file}" "${file}.tmp" 2>/dev/null
    nss_dscp_remove_table
    return 0
}

# statement of an upload rule for class $1 (high|bulk): the tag for the upload
# shaper; nothing while the classes are not active
nss_dscp_up_stmt() {
    local tag

    [ "${NSS_DSCP_ACTIVE}" -eq 1 ] || return 0
    case "$1" in
        high) tag=11:0 ;;
        *)    tag=13:0 ;;
    esac
    printf 'meta priority set %s' "${tag}"
}

# Print the complete nft script, with @WAN@ in place of the WAN device name.
# The static rules (nss_dscp_match) come first and each ends with "accept", so
# the first one that matches decides and the DSCP rules below never see that
# packet ("accept" only ends this chain, other chains and hooks still run).
# "nostatic" as the argument leaves them out.
nss_dscp_ruleset() {
    local fam stmt cls expr

    printf 'add table inet %s\n' "${NSS_DSCP_TABLE}"
    printf 'delete table inet %s\n' "${NSS_DSCP_TABLE}"
    printf 'table inet %s {\n' "${NSS_DSCP_TABLE}"
    printf '\tchain forward_up {\n'
    printf '\t\ttype filter hook forward priority filter; policy accept;\n'
    if [ "${1:-}" != nostatic ] && [ -n "${NSS_DSCP_STATIC}" ]; then
        printf '%s\n' "${NSS_DSCP_STATIC}" | while read -r cls expr; do
            case "${cls}" in
                normal) stmt= ;;
                *) stmt=$(nss_dscp_up_stmt "${cls}")
                   [ -n "${stmt}" ] || continue
                   stmt=" ${stmt}" ;;
            esac
            printf '\t\toifname "@WAN@" %s counter%s accept\n' "${expr}" "${stmt}"
        done
    fi
    for fam in ip ip6; do
        if [ -n "${NSS_DSCP_HIGH_NUMS}" ]; then
            stmt=$(nss_dscp_up_stmt high)
            [ -n "${stmt}" ] && \
                printf '\t\toifname "@WAN@" %s dscp { %s } counter %s\n' \
                    "${fam}" "${NSS_DSCP_HIGH_NUMS}" "${stmt}"
        fi
        if [ -n "${NSS_DSCP_BULK_NUMS}" ]; then
            stmt=$(nss_dscp_up_stmt bulk)
            [ -n "${stmt}" ] && \
                printf '\t\toifname "@WAN@" %s dscp { %s } counter %s\n' \
                    "${fam}" "${NSS_DSCP_BULK_NUMS}" "${stmt}"
        fi
    done
    printf '\t}\n}\n'
}

# Create the tag rules. Never fails the start: without them every flow simply
# goes to the normal class, which is what the shaper did before. The rules are
# also saved in the rules file, so that 12-sqm-nss can load them later when the
# WAN device is not known yet or changes.
# nss_dscp_save RULESET: write the rules file (atomically); rc 1: could not
nss_dscp_save() {
    local file

    file=$(nss_dscp_rules_file)
    if [ -d "${file%/*}" ] && printf '%s\n' "$1" > "${file}.tmp" 2>/dev/null \
       && mv "${file}.tmp" "${file}" 2>/dev/null; then
        return 0
    fi
    rm -f "${file}.tmp" 2>/dev/null
    sqm_debug "DSCP classes: could not write ${file}"
    return 1
}

# nss_dscp_load RULESET DEV: load it into nft; prints nft's messages
nss_dscp_load() {
    printf '%s\n' "$1" | sed "s/@WAN@/$2/g" | "${NSS_NFT}" -f - 2>&1
}

nss_dscp_apply() {
    local dev ruleset out written=0 note=

    [ "${NSS_DSCP_ACTIVE}" -eq 1 ] || return 0
    if ! nss_have "${NSS_NFT}"; then
        sqm_warn "nft not found: DSCP classes exist but no packet is tagged, everything uses the normal class"
        return 0
    fi
    if [ -z "${NSS_DSCP_HIGH_NUMS}" ] && [ -z "${NSS_DSCP_BULK_NUMS}" ] && [ -z "${NSS_DSCP_STATIC}" ]; then
        sqm_warn "DSCP classes: no valid DSCP selected, everything uses the normal class"
        return 0
    fi

    ruleset=$(nss_dscp_ruleset)
    nss_dscp_save "${ruleset}" && written=1

    if ! dev=$(nss_dscp_wan_dev); then
        if [ "${written}" -eq 1 ]; then
            sqm_warn "DSCP classes: cannot determine the WAN device (is '${NSS_WAN_IFACE}' up?), no packet is tagged yet; 12-sqm-nss loads the saved rules when it comes up, or set nss_dscp_wan_dev"
        else
            sqm_warn "DSCP classes: cannot determine the WAN device (is '${NSS_WAN_IFACE}' up?), no packet is tagged; set nss_dscp_wan_dev"
        fi
        return 0
    fi

    if ! out=$(nss_dscp_load "${ruleset}" "${dev}"); then
        # a static rule that nft does not take must not cost the DSCP rules
        if [ -n "${NSS_DSCP_STATIC}" ] && { [ -n "${NSS_DSCP_HIGH_NUMS}" ] || [ -n "${NSS_DSCP_BULK_NUMS}" ]; }; then
            sqm_warn "DSCP classes: nft refused the static rules (${out}), loading the DSCP rules without them"
            NSS_DSCP_STATIC=
            NSS_DSCP_STATIC_N=0
            ruleset=$(nss_dscp_ruleset)
            if [ "${written}" -eq 1 ] && ! nss_dscp_save "${ruleset}"; then
                rm -f "$(nss_dscp_rules_file)" 2>/dev/null
            fi
            out=$(nss_dscp_load "${ruleset}" "${dev}") || {
                sqm_warn "DSCP classes: could not load the nft rules (${out}), no packet is tagged"
                nss_dscp_remove
                return 0
            }
        else
            sqm_warn "DSCP classes: could not load the nft rules (${out}), no packet is tagged"
            nss_dscp_remove
            return 0
        fi
    fi
    [ "${NSS_DSCP_STATIC_N}" -gt 0 ] && note=", ${NSS_DSCP_STATIC_N} static rule(s) first"
    sqm_log "DSCP classes: out via ${dev}, high (11:) DSCP ${NSS_DSCP_HIGH_NUMS:-none}, bulk (13:) DSCP ${NSS_DSCP_BULK_NUMS:-none}${note}"
    return 0
}

###############################################################################
# nssifb interface handling
###############################################################################

nss_ifb_exists() {
    [ -d "${SYSFS}/class/net/${NSS_IFB}" ]
}

nss_ifb_teardown() {
    nss_ifb_exists || return 0
    SILENT=1 $TC qdisc del dev "${NSS_IFB}" root
    if [ -n "${DELETENSSIFB}" ]; then
        SILENT=1 $IP link set dev "${NSS_IFB}" down
        SILENT=1 $IP link delete dev "${NSS_IFB}" type nss_ifb
        sqm_debug "${NSS_IFB} interface deleted"
    else
        sqm_debug "not deleting ${NSS_IFB} (nss_keep_ifb)"
    fi
    return 0
}

# kernel module + fresh nssifb interface
nss_prepare_ifb() {
    # the standard sqm-scripts do_modules() knows nothing about nss-ifb
    if [ ! -d "${SYSFS}/module/nss_ifb" ]; then
        sqm_log "required nss_ifb kernel module not detected, loading it now.."
        ${INSMOD} nss-ifb 2>>"${OUTPUT_TARGET}"
        if [ ! -d "${SYSFS}/module/nss_ifb" ]; then
            sqm_error "kernel module nss-ifb failed to load (is kmod-nss-ifb installed?)"
            return 1
        fi
    fi

    # which physical device nssifb redirects; has to be set before it is brought up
    if [ -w "${SYSFS}/module/nss_ifb/parameters/nss_dev_name" ]; then
        printf '%s' "${NSS_DEV}" > "${SYSFS}/module/nss_ifb/parameters/nss_dev_name" || \
            sqm_warn "could not set nss_ifb source device to ${NSS_DEV}"
    else
        sqm_debug "nss_ifb has no writable nss_dev_name parameter, assuming the default (eth0)"
    fi

    # start from a clean interface when a previous run left one behind
    if nss_ifb_exists && [ -n "${DELETENSSIFB}" ]; then
        sqm_debug "${NSS_IFB} already exists, recreating it"
        nss_ifb_teardown
    fi

    if ! nss_ifb_exists; then
        sqm_log "${NSS_IFB} interface does not exist, creating.."
        $IP link add dev "${NSS_IFB}" type nss_ifb || return 1
    fi
    return 0
}

###############################################################################
# start / stop / cleanup, called by sqm-scripts
###############################################################################

# undo whatever a failed start left behind
nss_rollback() {
    sqm_debug "rolling back partial NSS shaper setup"
    nss_dscp_remove
    SILENT=1 $TC qdisc del dev "${NSS_DEV}" root
    nss_ifb_teardown
    return 0
}

# the actual setup, once
nss_start_once() {
    NSS_DSCP_ACTIVE=0
    # no tag rules of an earlier run, whatever happens below
    nss_dscp_remove

    if [ "${UPLINK}" -ne 0 ]; then
        CUR_DIRECTION="egress"
        nss_egress || return 1
    else
        SILENT=1 $TC qdisc del dev "${NSS_DEV}" root
        sqm_log "egress shaping deactivated"
    fi

    if [ "${DOWNLINK}" -ne 0 ]; then
        CUR_DIRECTION="ingress"
        nss_prepare_ifb || return 1
        nss_ingress || return 1
    else
        nss_ifb_teardown
        sqm_log "ingress shaping deactivated"
    fi

    # trust but verify: the qdiscs must really be there
    if [ "${UPLINK}" -ne 0 ] && ! nss_has_shaper "${NSS_DEV}"; then
        sqm_error "verification failed: no NSS shaper on ${NSS_DEV}"
        return 1
    fi
    if [ "${DOWNLINK}" -ne 0 ] && ! nss_has_shaper "${NSS_IFB}"; then
        sqm_error "verification failed: no NSS shaper on ${NSS_IFB}"
        return 1
    fi

    # the tag rules go in last, once the queues they point to really exist
    if [ "${NSS_DSCP_CLASSES:-0}" -eq 1 ] && [ "${NSS_DSCP_ACTIVE}" -ne 1 ]; then
        sqm_debug "DSCP classes requested but not active (egress shaping off or the classes could not be built)"
    fi
    nss_dscp_apply
    return 0
}

###############################################################################
# sqm-autorate
#
# A start (and so every restart) of this script resets the shapers to the
# static rates and bursts of the SQM config. sqm-autorate only talks to tc when
# its own rate changes, so after a restart it would keep running on the wrong
# values. A SIGHUP ("reload") makes it re-apply everything immediately.
#
# Nothing here can fail a start and nothing needs the user:
#   * autorate not installed (no init script)        -> skipped
#   * installed but not running (stopped, disabled,
#     crashed, SQM start at boot before it)          -> skipped, NEVER started
#   * running (however it was started)               -> reload
#   * reload fails or hangs                          -> warning, start goes on
###############################################################################
nss_autorate_reload() {
    local init="${NSS_AUTORATE_INIT}" out rc

    [ "${NSS_RELOAD_AUTORATE:-1}" -eq 1 ] || return 0

    if [ ! -f "${init}" ] || [ ! -x "${init}" ]; then
        sqm_debug "sqm-autorate is not installed, nothing to reload"
        return 0
    fi
    if ! "${init}" status >/dev/null 2>&1; then
        sqm_debug "sqm-autorate is not running, nothing to reload"
        return 0
    fi

    # let the NSS side settle after the shapers were attached (same idea as the
    # sleep before nssifb is brought up)
    sleep 1

    # a hung init script must never block the SQM start (which holds the run lock)
    if nss_have timeout && timeout 5 true >/dev/null 2>&1; then
        out=$(timeout 10 "${init}" reload 2>&1)
    else
        out=$("${init}" reload 2>&1)
    fi
    rc=$?
    if [ "${rc}" -eq 0 ]; then
        sqm_log "sqm-autorate is running, asked it to reload so it re-applies its rates"
    else
        sqm_warn "could not reload sqm-autorate (rc ${rc}): ${out}"
    fi
    return 0
}

# We override the stock sqm_start: it calls verify_qdisc, which creates and
# destroys ifb devices and knows nothing about the NSS qdiscs.
sqm_start() {
    local attempt=1

    sqm_debug "sqm_start: starting nss-rk.qos"
    [ -n "${IFACE}" ] || return 1

    nss_init_config || return 1
    nss_preflight || return 1
    nss_wait_ready || return 1

    while :; do
        if nss_start_once; then
            nss_autorate_reload
            return 0
        fi
        nss_rollback
        if [ "${attempt}" -ge "${NSS_START_ATTEMPTS}" ]; then
            sqm_error "NSS shaping could not be started on ${IFACE} after ${attempt} attempt(s), giving up"
            return 1
        fi
        sqm_warn "NSS shaping attempt ${attempt}/${NSS_START_ATTEMPTS} failed, retrying in 3s"
        attempt=$((attempt + 1))
        sleep 3
    done
}

# Custom stop: the standard function would delete an ifb of the wrong type.
sqm_stop() {
    # stop-sqm never runs sqm_start, so read the options that matter here too
    nss_uci_load
    nss_apply_keep_ifb
    nss_dscp_remove
    SILENT=1 $TC qdisc del dev "${NSS_DEV}" root
    nss_ifb_teardown
    nss_have nft_cleanup && nft_cleanup
    return 0
}

# called by stop-sqm for "run.sh cleanup"
sqm_cleanup() {
    sqm_stop
}

# NSS qdiscs are fq_codel only
cake_egress()  { sqm_error "The NSS shaper is only compatible with fq_codel."; return 1; }
cake_ingress() { sqm_error "The NSS shaper is only compatible with fq_codel."; return 1; }

###############################################################################
# BAIL OUT WHEN CALLED FROM HOTPLUG
#
# /etc/hotplug.d/iface/11-sqm restarts SQM whenever an interface associated
# with the device changes state. With NSS the shaper sits on a hardware device
# and does not care about ifup/ifdown, while bouncing nssifb up and down in
# quick succession can crash the router. So when hotplug calls us and the NSS
# shaper is installed already, leave it alone. If it is NOT installed (SQM came
# up before the interface did), carry on and install it.
#
# Note for DSA builds (R7800, C2600, ...): hotplug reports the user port ("wan")
# as DEVICE, which never matches the SQM instance on eth0, so sqm-scripts'
# hotplug script does not restart or start it at all there. If the start at
# boot failed, the optional 12-sqm-nss hotplug script (shipped next to this
# file) starts it again when the WAN interface comes up.
###############################################################################

if [ -n "${ACTION}" ] && [ -n "${INTERFACE}" ] && [ -n "${DEVICE}" ]; then
    sqm_debug "${SCRIPT}: triggered by hotplug ${ACTION} for ${INTERFACE} (${DEVICE})"
    if nss_shaper_present; then
        sqm_log "${SCRIPT}: NSS shaper already installed on ${NSS_DEV}, not touching it on hotplug ${ACTION} ${INTERFACE}"
        exit 0
    fi
    sqm_debug "${SCRIPT}: no complete NSS shaper detected, continuing"
fi

# vim: syntax=sh ts=4 sw=4 sts=4
