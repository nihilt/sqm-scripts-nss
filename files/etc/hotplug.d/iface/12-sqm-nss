#!/bin/sh
# /etc/hotplug.d/iface/12-sqm-nss   (optional, chmod 755)
#
# Safety net for nss-rk.qos on DSA builds.
#
# sqm-scripts' own hotplug script (11-sqm) acts on the device that hotplug
# reports. On DSA that is the user port ("wan"), while SQM runs on the eth
# device (eth0), so it never matches and SQM is only ever started at boot. If
# that start failed (eth0 not up in time, NSS firmware timeout, ...), nothing
# retries it.
#
# This script starts SQM for every nss-rk.qos instance that is NOT running
# when the WAN interface comes up. It never touches an instance that is
# already running, so it cannot bounce nssifb.

[ "$ACTION" = ifup ] || exit 0
[ -n "$INTERFACE" ] || exit 0

. /lib/functions.sh
. /etc/sqm/sqm.conf

/etc/init.d/sqm enabled || exit 0

start_if_missing() {
    local section="$1" iface script enabled wan
    config_get script "$section" script
    [ "$script" = "nss-rk.qos" ] || return 0
    config_get enabled "$section" enabled 0
    [ "$enabled" = "1" ] || return 0
    config_get iface "$section" interface
    [ -n "$iface" ] || return 0

    # the logical interface this instance waits for (same option as nss-rk.qos)
    config_get wan "$section" nss_wan_iface wan
    [ "$INTERFACE" = "$wan" ] || return 0

    [ -f "${SQM_STATE_DIR}/${iface}.state" ] && return 0

    # an SQM start/stop is in progress right now (run.sh holds this lock while
    # nss-rk.qos waits for the WAN at boot): let it finish
    [ -d "${SQM_STATE_DIR}/sqm-run.lock" ] && return 0

    logger -t sqm-nss "SQM is not running on ${iface} although ${INTERFACE} came up, starting it"
    /usr/lib/sqm/run.sh start "${iface}"
}

config_load sqm
config_foreach start_if_missing queue
