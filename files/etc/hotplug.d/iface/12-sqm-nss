#!/bin/sh
# /etc/hotplug.d/iface/12-sqm-nss   (optional, chmod 755)
# version 20261120.1
#
# Safety net for nss-rk.qos on DSA builds. When the logical WAN interface
# (nss_wan_iface, default wan) comes up it does two things, and nothing else:
#
#   1. SQM is not running for an nss-rk.qos instance: start it.
#
#      sqm-scripts' own hotplug script (11-sqm) acts on the device that hotplug
#      reports. On DSA that is the user port ("wan"), while SQM runs on the eth
#      device (eth0), so it never matches and SQM is only ever started at boot.
#      If that start failed (eth0 not up in time, NSS firmware timeout, ...),
#      nothing retries it. At most one start per 60 seconds and instance.
#
#   2. SQM is running and nss-rk.qos saved its upload class rules
#      (${SQM_STATE_DIR}/<iface>.nss-dscp.nft, only written when nss_dscp_classes
#      is on; the file holds the DSCP rules and, from nss-rk.qos 20261120.2 on,
#      the static rules of nss_dscp_match): load them again when the nft table
#      is gone, a chain of it is missing, or it matches another WAN device than
#      the one the interface has now (the WAN device was not known when SQM
#      started, PPPoE came back with another name, ...). Nothing is loaded when
#      the table is already right, so its counters are not reset.
#
# It never restarts a running instance and never touches tc or nssifb, so it
# cannot bounce nssifb.
#
# Environment (all optional):
#   NSS_HOTPLUG_LOCK_WAIT  seconds to wait for a running SQM start/stop (30)

[ "$ACTION" = ifup ] || exit 0
[ -n "$INTERFACE" ] || exit 0

. /lib/functions.sh
. /etc/sqm/sqm.conf

/etc/init.d/sqm enabled || exit 0

LOCK_WAIT=${NSS_HOTPLUG_LOCK_WAIT:-30}
case "${LOCK_WAIT}" in ''|*[!0-9]*) LOCK_WAIT=30 ;; esac

# a plain interface name, the same rule nss-rk.qos applies
valid_dev() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#1}" -le 15 ]
}

# wan_dev SECTION WANIFACE: the device the DSCP rules have to match
wan_dev() {
    local dev json

    config_get dev "$1" nss_dscp_wan_dev
    if [ -z "${dev}" ]; then
        json=$(ubus call "network.interface.$2" status 2>/dev/null) || return 1
        dev=$(printf '%s' "${json}" | jsonfilter -e '@.l3_device' 2>/dev/null)
    fi
    valid_dev "${dev}" || return 1
    printf '%s' "${dev}"
}

# rules_current FILE TABLE DEV: is the loaded table what FILE describes for DEV?
rules_current() {
    local file="$1" table="$2" dev="$3" chain devs

    nft list table inet "${table}" >/dev/null 2>&1 || return 1
    for chain in $(sed -n 's/^[[:space:]]*chain \([A-Za-z0-9_]*\) {.*/\1/p' "${file}"); do
        nft list chain inet "${table}" "${chain}" >/dev/null 2>&1 || return 1
    done
    devs=$(nft list table inet "${table}" 2>/dev/null | \
        sed -n 's/.*[io]ifname "\([^"]*\)".*/\1/p' | sort -u)
    [ "${devs}" = "${dev}" ]
}

# refresh_rules SECTION IFACE WANIFACE
refresh_rules() {
    local file="${SQM_STATE_DIR}/$2.nss-dscp.nft" table dev out

    [ -s "${file}" ] || return 0
    command -v nft >/dev/null 2>&1 || return 0
    table=$(sed -n 's/^table inet \([A-Za-z0-9_]*\) {.*/\1/p' "${file}" | head -n 1)
    [ -n "${table}" ] || return 0
    dev=$(wan_dev "$1" "$3") || return 0

    rules_current "${file}" "${table}" "${dev}" && return 0

    if out=$(sed "s/@WAN@/${dev}/g" "${file}" | nft -f - 2>&1); then
        logger -t sqm-nss "loaded the DSCP class rules for ${dev} (${file})"
    else
        logger -t sqm-nss "could not load the DSCP class rules from ${file} for ${dev}: ${out}"
    fi
    return 0
}

handle_instance() {
    local section="$1" iface script enabled wan i=0 stamp now last

    config_get script "${section}" script
    [ "${script}" = "nss-rk.qos" ] || return 0
    config_get enabled "${section}" enabled 0
    [ "${enabled}" = "1" ] || return 0
    config_get iface "${section}" interface
    [ -n "${iface}" ] || return 0

    # the logical interface this instance waits for (same option as nss-rk.qos)
    config_get wan "${section}" nss_wan_iface wan
    [ "${INTERFACE}" = "${wan}" ] || return 0

    # an SQM start/stop is in progress right now (run.sh holds this lock while
    # nss-rk.qos waits for the WAN at boot): let it finish
    while [ -d "${SQM_STATE_DIR}/sqm-run.lock" ] && [ "${i}" -lt "${LOCK_WAIT}" ]; do
        sleep 1
        i=$((i + 1))
    done
    if [ -d "${SQM_STATE_DIR}/sqm-run.lock" ]; then
        logger -t sqm-nss "SQM on ${iface} is still busy after ${LOCK_WAIT}s, not touching it"
        return 0
    fi

    if [ ! -f "${SQM_STATE_DIR}/${iface}.state" ]; then
        # not running: start it, but not more than once a minute
        stamp="/var/run/12-sqm-nss.${iface}.last"
        now=$(date +%s)
        last=$(cat "${stamp}" 2>/dev/null)
        case "${last}" in ''|*[!0-9]*) last=0 ;; esac
        if [ "${last}" -le "${now}" ] && [ $((now - last)) -lt 60 ]; then
            return 0
        fi
        echo "${now}" > "${stamp}" 2>/dev/null
        logger -t sqm-nss "SQM is not running on ${iface} although ${INTERFACE} came up, starting it"
        /usr/lib/sqm/run.sh start "${iface}"
        return 0
    fi

    refresh_rules "${section}" "${iface}" "${wan}"
}

config_load sqm
config_foreach handle_instance queue
